<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Shopping List result screen.

  Layout:
    top    — "Shopping List" heading + loading spinner
    center — ScrollPane containing a VBox whose children are built
             programmatically by ShoppingListResultViewController
             (one section per recipe: bold title header + bordered
             checkbox list of ingredients)
    bottom — ← Back button (right-aligned)

  No fx:controller — the controller is supplied via loader.setController()
  in CookYourBooksGuiApp, following the SearchView.fxml convention.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            styleClass="library-root"
            maxWidth="Infinity"
            maxHeight="Infinity">

    <!-- ── Top: heading + spinner ── -->
    <top>
        <HBox styleClass="library-toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="Shopping List" styleClass="page-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="loadingSpinner"
                               prefWidth="20"
                               prefHeight="20"
                               visible="false"
                               managed="false"/>
        </HBox>
    </top>

    <!-- ── Center: scrollable section container ── -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="library-scroll">
            <content>
                <VBox fx:id="sectionsContainer" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <!-- Recipe sections are added here programmatically -->
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ── Bottom: Back button ── -->
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="8" right="16" bottom="12" left="16"/>
            </padding>
            <Button fx:id="backButton" text="← Back" styleClass="library-btn-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
