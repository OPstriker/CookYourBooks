<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- divides top, center, bottom -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.cookyourbooks.gui.view.RecipeEditorViewController"
            style="-fx-padding: 16;">

            <!-- temporary ID field for testing, title row below, status label underneath-->
    <top>
        <VBox>
            <padding><Insets top="0" right="0" bottom="12" left="0"/></padding>

            <!-- Title label so the user knows what the text field is for -->
            <Label text="Recipe Title" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
            <!-- Title input row — editButton moved to bottom bar so it sits next to Back -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="titleField" promptText="Recipe title" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="statusLabel" styleClass="status-label" style="-fx-font-size: 12px;"/>
        </VBox>
    </top>
<!-- splits left panel to ingredient, right panel for instructions that is read only -->
    <center>
        <VBox spacing="12">

            <!-- ingredients panel -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Ingredients" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addIngredientButton" text="+ Add Ingredient" styleClass="editor-btn-success"/>
                </HBox>
                <ListView fx:id="ingredientsList" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- instructions panel — cannot edit -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="Instructions" styleClass="section-title"/>
                <ListView fx:id="instructionsList" VBox.vgrow="ALWAYS"/>
            </VBox>

        </VBox>
    </center>
<!-- has back and edit/done buttons — editButton moved here from title row -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets top="12"/></padding>
            <Button fx:id="backButton" text="Back" styleClass="editor-btn-secondary"/>
            <Button fx:id="editButton" text="Edit" styleClass="editor-btn-primary"/>
        </HBox>
    </bottom>

</BorderPane>
