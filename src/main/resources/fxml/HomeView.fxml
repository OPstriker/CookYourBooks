<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.cookyourbooks.gui.view.HomeViewController"
      styleClass="home-root"
      alignment="CENTER"
      spacing="16"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <!-- App icon / emoji -->
    <Label text="📖" styleClass="home-icon"/>

    <!-- App title -->
    <Label text="CookYourBooks" styleClass="home-title"/>

    <!-- Tagline -->
    <Label text="Your personal recipe library, powered by OCR."
           styleClass="home-tagline"/>

    <!-- Primary CTA -->
    <VBox alignment="CENTER" spacing="0">
        <padding>
            <Insets top="16"/>
        </padding>
        <Button fx:id="startButton" text="Start Cooking  →" styleClass="home-btn"/>
    </VBox>

</VBox>
